# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.env
.env.*
!.env.example
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Local SDK, signing, and generated platform configuration
/android/local.properties
/android/.gradle/
/android/key.properties
*.keystore
*.jks
*.p12
*.mobileprovision
/ios/Flutter/Generated.xcconfig
/ios/Flutter/flutter_export_environment.sh
/ios/Flutter/ephemeral/

# Local public-data inputs and generated review outputs
/data/raw/*
!/data/raw/.gitkeep
/data/review/*.csv
/data/staging/*.csv
!/data/staging/.gitkeep

# Local manual-review decisions containing external place identifiers
/data/config/kakao_burger_address_recheck_targets.json
/data/config/kakao_manual_review_decisions.json
/data/config/manual_address_resolutions.json
/data/config/yongsan_staging_hold_rules.json

# Generated development-only Flutter staging assets
/assets/dev/*.json
!/assets/dev/.gitkeep
